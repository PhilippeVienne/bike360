# Service utilisateur systemd du serveur Rust (installé par packaging/install.sh).
# Réglages locaux (dossier DCIM, adresse, port) : ~/.config/bike360/server.env
[Unit]
Description=Tri et montage des balades Insta360 (serveur local)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# ffmpeg/ffprobe peuvent être installés dans ~/.local/bin (absent du PATH des services)
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=%h/.config/bike360/server.env
ExecStart=%h/.local/bin/bike360-server ${DCIM} --host ${HOST} --port ${PORT}
Restart=on-failure
RestartSec=5
# le moteur GPU (bike360-render) est cherché à côté de l'exécutable
Nice=5

[Install]
WantedBy=default.target
