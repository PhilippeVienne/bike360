# Service utilisateur systemd du serveur Rust (installé par packaging/install.sh).
# Réglages locaux (dossier DCIM, adresse, port) : ~/.config/insta-build/server.env
[Unit]
Description=Tri et montage des balades Insta360 (serveur local)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=%h/.config/insta-build/server.env
ExecStart=%h/.local/bin/insta-server ${DCIM} --host ${HOST} --port ${PORT}
Restart=on-failure
RestartSec=5
# le moteur GPU (insta-render) est cherché à côté de l'exécutable
Nice=5

[Install]
WantedBy=default.target
